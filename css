/* =========================================
   1. CSS VARIABLES & RESET
========================================= */
:root {
  --bg-dark: #090a14;
  --bg-card: rgba(18, 21, 41, 0.78);
  --neon-pink: #ff2a85;
  --neon-cyan: #00f3ff;
  --neon-purple: #9d4edd;
  --sakura-pink: #ffb7c5;
  --text-main: #f0f4ff;
  --text-muted: #9aa5ce;
  --border-glow: rgba(0, 243, 255, 0.35);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  scroll-behavior: smooth;
}

body {
  background-color: var(--bg-dark);
  color: var(--text-main);
  font-family: 'Poppins', sans-serif;
  overflow-x: hidden;
  line-height: 1.6;
  background-image:
    radial-gradient(circle at 15% 20%, rgba(157, 78, 221, 0.16), transparent 35%),
    radial-gradient(circle at 85% 75%, rgba(255, 42, 133, 0.14), transparent 35%),
    linear-gradient(rgba(0, 243, 255, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 243, 255, 0.03) 1px, transparent 1px);
  background-size: 100% 100%, 100% 100%, 40px 40px, 40px 40px;
}

/* =========================================
   2. FALLING SAKURA PETALS ANIMATION (PURE CSS)
========================================= */
.sakura-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
  overflow: hidden;
}

.petal {
  position: absolute;
  top: -10%;
  background: linear-gradient(135deg, #ffd1dc, #ff7eb3);
  border-radius: 150% 0 150% 0;
  opacity: 0.75;
  box-shadow: 0 0 8px rgba(255, 183, 197, 0.6);
  animation: fall linear infinite;
}

.petal:nth-child(1)  { left: 5%;  width: 14px; height: 10px; animation-duration: 11s; animation-delay: 0s; }
.petal:nth-child(2)  { left: 15%; width: 10px; height: 8px;  animation-duration: 14s; animation-delay: 2s; }
.petal:nth-child(3)  { left: 28%; width: 16px; height: 12px; animation-duration: 12s; animation-delay: 4s; }
.petal:nth-child(4)  { left: 40%; width: 12px; height: 9px;  animation-duration: 15s; animation-delay: 1s; }
.petal:nth-child(5)  { left: 52%; width: 15px; height: 11px; animation-duration: 10s; animation-delay: 3s; }
.petal:nth-child(6)  { left: 65%; width: 11px; height: 8px;  animation-duration: 13s; animation-delay: 5s; }
.petal:nth-child(7)  { left: 77%; width: 15px; height: 12px; animation-duration: 16s; animation-delay: 2.5s; }
.petal:nth-child(8)  { left: 88%; width: 12px; height: 9px;  animation-duration: 11.5s; animation-delay: 0.5s; }
.petal:nth-child(9)  { left: 95%; width: 14px; height: 10px; animation-duration: 14.5s; animation-delay: 3.5s; }

@keyframes fall {
  0% {
    transform: translateY(0) translateX(0) rotate(0deg);
    opacity: 0;
  }
  10% { opacity: 0.85; }
  50% { transform: translateY(50vh) translateX(45px) rotate(180deg); }
  90% { opacity: 0.8; }
  100% {
    transform: translateY(110vh) translateX(-35px) rotate(360deg);
    opacity: 0;
  }
}

/* =========================================
   3. NAVIGATION BAR
========================================= */
header {
  position: sticky;
  top: 0;
  z-index: 100;
  backdrop-filter: blur(12px);
  background: rgba(9, 10, 20, 0.85);
  border-bottom: 1px solid var(--border-glow);
}

nav {
  max-width: 1150px;
  margin: 0 auto;
  padding: 1rem 2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  font-family: 'Orbitron', sans-serif;
  font-weight: 900;
  font-size: 1.3rem;
  letter-spacing: 2px;
  color: var(--neon-cyan);
  text-shadow: 0 0 10px rgba(0, 243, 255, 0.5);
}

.logo span {
  color: var(--neon-pink);
}

.nav-links {
  list-style: none;
  display: flex;
  gap: 2rem;
}

.nav-links a {
  text-decoration: none;
  color: var(--text-main);
  font-size: 0.92rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1px;
  position: relative;
  transition: color 0.3s ease;
}

.nav-links a::after {
  content: '';
  position: absolute;
  bottom: -5px;
  left: 0;
  width: 0%;
  height: 2px;
  background: linear-gradient(90deg, var(--neon-pink), var(--neon-cyan));
  transition: width 0.3s ease;
}

.nav-links a:hover {
  color: var(--neon-cyan);
}

.nav-links a:hover::after {
  width: 100%;
}

/* =========================================
   4. HERO SECTION & ANIME AVATAR RING
========================================= */
main {
  position: relative;
  z-index: 5;
  max-width: 1150px;
  margin: 0 auto;
  padding: 0 2rem;
}

.hero {
  min-height: 88vh;
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  align-items: center;
  gap: 3rem;
  padding: 3rem 0;
}

.badge {
  display: inline-block;
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.85rem;
  color: var(--neon-cyan);
  background: rgba(0, 243, 255, 0.1);
  border: 1px solid var(--neon-cyan);
  padding: 0.35rem 0.9rem;
  border-radius: 4px;
  margin-bottom: 1.2rem;
  box-shadow: 0 0 12px rgba(0, 243, 255, 0.2);
}

.hero h1 {
  font-family: 'Orbitron', sans-serif;
  font-size: clamp(2.2rem, 4.5vw, 3.6rem);
  font-weight: 900;
  line-height: 1.15;
  margin-bottom: 1rem;
}

.hero h1 .highlight {
  background: linear-gradient(90deg, var(--neon-pink), var(--neon-cyan));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.typing-subtitle {
  font-family: 'JetBrains Mono', monospace;
  font-size: 1.1rem;
  color: var(--sakura-pink);
  margin-bottom: 1.2rem;
  border-right: 2px solid var(--neon-cyan);
  white-space: nowrap;
  overflow: hidden;
  width: fit-content;
  animation: blinkCursor 0.8s infinite;
}

@keyframes blinkCursor {
  50% { border-color: transparent; }
}

.hero p {
  color: var(--text-muted);
  font-size: 1.02rem;
  max-width: 560px;
  margin-bottom: 2rem;
}

.hero-buttons {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.btn {
  padding: 0.8rem 1.7rem;
  font-family: 'Orbitron', sans-serif;
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  text-decoration: none;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.3s ease;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
}

.btn-primary {
  background: linear-gradient(135deg, var(--neon-pink), var(--neon-purple));
  color: #fff;
  border: none;
  box-shadow: 0 0 20px rgba(255, 42, 133, 0.45);
}

.btn-primary:hover {
  transform: translateY(-3px);
  box-shadow: 0 0 30px rgba(255, 42, 133, 0.8);
}

.btn-outline {
  background: transparent;
  color: var(--neon-cyan);
  border: 1.5px solid var(--neon-cyan);
}

.btn-outline:hover {
  background: rgba(0, 243, 255, 0.12);
  transform: translateY(-3px);
  box-shadow: 0 0 20px rgba(0, 243, 255, 0.35);
}

/* Profile Picture Frame with Orbiting Rings */
.avatar-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.2rem;
}

.avatar-frame {
  position: relative;
  width: 290px;
  height: 290px;
  display: flex;
  justify-content: center;
  align-items: center;
  animation: floatAvatar 4s ease-in-out infinite;
}

@keyframes floatAvatar {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-12px); }
}

.orbit-ring-1 {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 2px dashed var(--neon-cyan);
  animation: spinClockwise 14s linear infinite;
}

.orbit-ring-2 {
  position: absolute;
  width: 88%;
  height: 88%;
  border-radius: 50%;
  border: 2px solid transparent;
  border-top-color: var(--neon-pink);
  border-bottom-color: var(--neon-purple);
  animation: spinCounter 9s linear infinite;
}

@keyframes spinClockwise {
  100% { transform: rotate(360deg); }
}

@keyframes spinCounter {
  100% { transform: rotate(-360deg); }
}

.profile-pic {
  width: 225px;
  height: 225px;
  border-radius: 50%;
  object-fit: cover;
  border: 4px solid var(--neon-pink);
  box-shadow: 0 0 30px rgba(255, 42, 133, 0.5), inset 0 0 20px rgba(0, 243, 255, 0.4);
  z-index: 2;
  background-color: #161936;
}

.level-tag {
  position: absolute;
  bottom: 12px;
  z-index: 3;
  background: #090a14;
  border: 1.5px solid var(--neon-cyan);
  color: var(--neon-cyan);
  font-family: 'Orbitron', sans-serif;
  font-size: 0.78rem;
  font-weight: 700;
  padding: 0.25rem 0.85rem;
  border-radius: 20px;
  box-shadow: 0 0 12px rgba(0, 243, 255, 0.5);
}

.photo-actions {
  display: flex;
  gap: 0.6rem;
  align-items: center;
}

.upload-label,
.reset-btn {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.8rem;
  color: var(--text-muted);
  background: transparent;
  cursor: pointer;
  border: 1px dashed var(--border-glow);
  padding: 0.4rem 0.85rem;
  border-radius: 6px;
  transition: all 0.25s ease;
}

.upload-label:hover,
.reset-btn:hover {
  color: var(--neon-cyan);
  border-color: var(--neon-cyan);
}

#photoInput {
  display: none;
}

/* =========================================
   5. SECTION HEADERS & RPG CHARACTER CARD
========================================= */
section {
  padding: 4.5rem 0;
}

.section-title {
  font-family: 'Orbitron', sans-serif;
  font-size: 1.9rem;
  margin-bottom: 2rem;
  display: flex;
  align-items: center;
  gap: 0.8rem;
}

.section-title span {
  color: var(--neon-pink);
  font-size: 1.1rem;
  font-family: 'JetBrains Mono', monospace;
}

.section-title::after {
  content: '';
  flex: 1;
  height: 1px;
  background: linear-gradient(90deg, var(--border-glow), transparent);
}

.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
}

.hud-card {
  background: var(--bg-card);
  border: 1px solid var(--border-glow);
  border-radius: 12px;
  padding: 1.8rem;
  backdrop-filter: blur(10px);
  position: relative;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.hud-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 30px rgba(0, 243, 255, 0.15);
  border-color: var(--neon-cyan);
}

.hud-card h3 {
  font-family: 'Orbitron', sans-serif;
  color: var(--neon-cyan);
  margin-bottom: 1rem;
  font-size: 1.15rem;
}

.card-copy {
  color: var(--text-muted);
  margin-bottom: 1rem;
}

.card-copy:last-child {
  margin-bottom: 0;
}

.stat-list {
  list-style: none;
  display: grid;
  gap: 0.8rem;
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.9rem;
}

.stat-list li {
  display: flex;
  justify-content: space-between;
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  padding-bottom: 0.45rem;
}

.stat-label {
  color: var(--text-muted);
}

.stat-value {
  color: var(--sakura-pink);
  font-weight: 600;
}

.status-online {
  color: var(--neon-cyan);
}

/* =========================================
   6. ANIMATED SKILL BARS (BSIT 1ST YEAR)
========================================= */
.skills-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.5rem;
}

.skill-header {
  display: flex;
  justify-content: space-between;
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.9rem;
  margin-bottom: 0.5rem;
}

.progress-bar {
  width: 100%;
  height: 10px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 20px;
  overflow: hidden;
  margin-bottom: 1.2rem;
}

.progress-fill {
  height: 100%;
  border-radius: 20px;
  background: linear-gradient(90deg, var(--neon-pink), var(--neon-cyan));
  box-shadow: 0 0 10px var(--neon-cyan);
  animation: fillBar 1.8s ease-out forwards;
}

.w-90 { width: 90%; }
.w-85 { width: 85%; }
.w-80 { width: 80%; }
.w-78 { width: 78%; }
.w-70 { width: 70%; }
.w-65 { width: 65%; }

@keyframes fillBar {
  from { width: 0%; }
}

/* =========================================
   7. PROJECTS / QUEST LOG
========================================= */
.projects-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 1.8rem;
}

.quest-tag {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.75rem;
  color: var(--neon-pink);
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 0.4rem;
  display: block;
}

.quest-desc {
  color: var(--text-muted);
  font-size: 0.92rem;
}

.tech-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 1.2rem;
}

.tech-tags span {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.75rem;
  background: rgba(157, 78, 221, 0.2);
  border: 1px solid rgba(157, 78, 221, 0.5);
  color: #e0aaff;
  padding: 0.2rem 0.6rem;
  border-radius: 4px;
}

/* =========================================
   8. CONTACT & FOOTER
========================================= */
.contact-box {
  text-align: center;
  max-width: 650px;
  margin: 0 auto;
}

.contact-desc {
  color: var(--text-muted);
  margin-top: 0.6rem;
}

.social-links {
  display: flex;
  justify-content: center;
  gap: 1.2rem;
  margin-top: 1.8rem;
  flex-wrap: wrap;
}

footer {
  text-align: center;
  padding: 2rem;
  border-top: 1px solid var(--border-glow);
  color: var(--text-muted);
  font-size: 0.85rem;
  font-family: 'JetBrains Mono', monospace;
}

/* =========================================
   9. RESPONSIVE DESIGN
========================================= */
@media (max-width: 850px) {
  .hero {
    grid-template-columns: 1fr;
    text-align: center;
  }
  .hero p {
    margin-left: auto;
    margin-right: auto;
  }
  .typing-subtitle {
    margin-left: auto;
    margin-right: auto;
  }
  .hero-buttons {
    justify-content: center;
  }
  .avatar-wrapper {
    order: -1;
  }
  .about-grid {
    grid-template-columns: 1fr;
  }
  .nav-links {
    display: none;
  }
}